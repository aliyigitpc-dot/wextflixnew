@import url("https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800&display=swap");

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: #141210;
  --foreground: #f8f6f4;
  --card: #1e1b18;
  --card-foreground: #f8f6f4;
  --primary: #e5293a;
  --primary-foreground: #ffffff;
  --secondary: #2a2724;
  --secondary-foreground: #f8f6f4;
  --muted: #2a2724;
  --muted-foreground: #7a7673;
  --border: #2e2b28;
  --input: #2e2b28;
  --ring: #e5293a;
  --gradient-hero: linear-gradient(180deg, transparent 0%, rgba(20,18,16,0.6) 50%, #141210 100%);
  --gradient-side: linear-gradient(90deg, #141210 0%, rgba(20,18,16,0.7) 40%, transparent 100%);
  --shadow-glow: 0 0 40px rgba(229,41,58,0.4);
  --shadow-card: 0 20px 50px rgba(0,0,0,0.7);
}

* {
  border-color: var(--border);
  box-sizing: border-box;
}

html {
  color-scheme: dark;
}

body {
  background-color: var(--background);
  color: var(--foreground);
  font-family: 'Inter', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  margin: 0;
  padding: 0;
}

h1, h2, h3, h4 {
  font-family: 'Bebas Neue', Impact, sans-serif;
  letter-spacing: 0.02em;
}

.scrollbar-hide::-webkit-scrollbar { display: none; }
.scrollbar-hide { scrollbar-width: none; }
.text-glow { text-shadow: 0 0 20px rgba(229,41,58,0.6); }
